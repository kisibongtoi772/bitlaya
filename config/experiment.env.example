# Data directory containing train.jsonl, val.jsonl, test.jsonl
DATA_DIR=./data

# Trainable pretrained native-BitNet backbone.
MODEL_REPO=Rabe3/1-bit-embedding-general
MODEL_SUBFOLDER=bf16
SEED=42

# Candidate encoding / True-Laya head.
MAX_LENGTH=384
EMBED_DIM=768
HEAD_LAYERS=2
HEAD_NHEAD=8
HEAD_FF=2048
HEAD_DROPOUT=0.10

# GPU training. -1 = full backbone; 0 = frozen backbone; N = last N transformer blocks.
UNFREEZE_LAST_N=6
EPOCHS=6
PER_DEVICE_BATCH=8
GRAD_ACCUM=2
BACKBONE_LR=2e-5
HEAD_LR=2e-4
WEIGHT_DECAY=0.01
WARMUP_RATIO=0.05
MAX_GRAD_NORM=1.0
NUM_WORKERS=0

# CPU evaluation of exported TQ1_0 backbone
CPU_EMBED_WORKERS=16
CPU_THREADS_PER_WORKER=16
CPU_SHARD_SIZE=512
CPU_UBATCH=2048
CPU_BATCH=4096
CPU_CTX=4096

# Cache directories (adjust to your environment or leave unset for defaults)
# HF_HOME=./cache/huggingface
# PIP_CACHE_DIR=./cache/pip
# TMPDIR=./tmp
